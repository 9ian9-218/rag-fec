# 快速配置示例
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写你的 API Key
# 3. 根据需要选择启用 Embedding 和 Rerank API

# ==========================================
# 基础服务配置（Neo4j, Milvus, LLM）
# ==========================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=default

# LLM 配置(路由+回答)

OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=

# ==========================================
# Embedding API 配置
# ==========================================

# 【选项 1】使用 SiliconFlow
EMBEDDING_API_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_TIMEOUT=60

# 【选项 2】使用本地模型（显卡推理，无需外网额度）
# 先下载模型：huggingface-cli download BAAI/bge-m3 --local-dir models/hub/bge-m3
# EMBEDDING_BACKEND=local
# EMBEDDING_LOCAL_MODEL_PATH=models/hub/bge-m3
# EMBEDDING_LOCAL_DEVICE=cuda          # cuda / cpu
# EMBEDDING_LOCAL_DTYPE=float32        # GTX16/RTX20 建议 float32；bf16 需算力 8.0+
# EMBEDDING_LOCAL_BATCH_SIZE=16
# EMBEDDING_LOCAL_MAX_CONCURRENCY=1    # 显存紧张保持 1
# 注意：Milvus 集合名由 EMBEDDING_API_MODEL_NAME 决定，保持 BAAI/bge-m3 可复用已有向量


# ==========================================
# Rerank 配置（二选一；两者都不可用时查询会显式关闭重排）
# ==========================================

# 【选项 1】本地 CrossEncoder（免费、数据不出域；推荐）
# 先下载权重：python scripts/download_reranker.py
# 下载后无需改开关：存在 models/hub 快照即自动启用本地重排
MODELS_RERANK_API_ENABLED=false
MODELS_RERANK_BATCH_SIZE=32
# 也可指向自备权重目录（留空则查 models/hub 快照）
MODELS_RERANKER_LOCAL_PATH=

# 【选项 2】线上 Rerank API（如 SiliconFlow）
# MODELS_RERANK_API_ENABLED=true
# MODELS_RERANK_API_KEY=
# MODELS_RERANK_API_BASE_URL=https://api.siliconflow.cn/v1
# MODELS_RERANK_API_MODEL_NAME=BAAI/bge-reranker-v2-m3
# MODELS_RERANK_API_TIMEOUT=60

# ==========================================
# 检索配置
# ==========================================
RETRIEVAL_DEFAULT_MODE=mix
RETRIEVAL_TOP_K=8
RETRIEVAL_RERANK_MIN_SCORE=0.35

# ==========================================
# Redis（默认关闭；实际压测如不使用可保持 false）
# ==========================================
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=300


# ==========================================
# PDF 转档（MinerU）
# ==========================================
# 流水线模式：two_stage=PDF 只在转档步骤处理，索引只读 .md；coupled=入库存联 MinerU/抽取
DOCUMENT_PIPELINE_MODE=two_stage
# 是否使用 MinerU 转 PDF；false 时回退到普通 PDF 抽取
DOCUMENT_USE_MINERU_FOR_PDF=true
# MinerU -b 推理后端（pipeline / vlm-engine / hybrid-engine）
DOCUMENT_MINERU_INFER_BACKEND=pipeline
# 是否忽略 MinerU 缓存强制重转
DOCUMENT_MINERU_FORCE_REFRESH=false

# ==========================================
# 其他配置（保持默认即可）
# ==========================================
CHUNK_CHUNK_SIZE=1200
CHUNK_CHUNK_OVERLAP=100

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
# 默认 true：文档上传/增量更新返回 202 + task_id 异步执行；
# 设为 false 时同步执行（长时间批量导入会阻塞该 HTTP 请求，前端需有任务轮询/超时）
SERVICE_ASYNC_DOCUMENT_PROCESSING_ENABLED=true
# 增量/文档处理锁持有超时（秒）。单个文档处理可能超过 480s，默认 7200
SERVICE_LOCK_TIMEOUT_SECONDS=7200

# 查询期 LLM 最大并发（默认 8）与索引插入期 LLM 最大并发（默认 4，与查询隔离）
LLM_MAX_CONCURRENT_CALLS=8
LLM_MAX_CONCURRENT_INSERT_CALLS=4
# 单次 LLM 请求超时（秒）；LightRAG Worker 超时 = 2×(timeout+120)，为其 3 次重试预留预算
LLM_TIMEOUT=180

PATHS_PROJECT_ROOT=.
PATHS_LIGHTRAG_WORKING_DIR=data/lightrag_workdir

# 领域 schema：实体类型指引与摘要语言（默认面向理工科科研论文/专著，18 类）
SCHEMA_SUMMARY_LANGUAGE=Chinese
# 覆写实体类型：JSON 数组（只给类型名）或对象（类型名 -> 说明）
# SCHEMA_ENTITY_TYPES_JSON=["TheoryOrModel","MethodOrAlgorithm","Dataset"]
# 整段覆写注入抽取提示词的指引（优先于上面的 JSON）
# SCHEMA_ENTITY_TYPES_GUIDANCE=Classify each entity using one of the following types. ...
# LightRAG 原生入口：整份替换类型指引与抽取示例（YAML，需含 entity_extraction_examples / _json_examples）
# ENTITY_TYPE_PROMPT_FILE=

# ---------------------------------------------------------------------------
# 社区摘要（可选能力，默认关闭）
# ---------------------------------------------------------------------------
# 能力总开关：false 时不构建、不注入、/communities/rebuild 返回 disabled；
# 开启后仍需调用方显式 use_community=true（或下方默认值改为 true）才会注入上下文
COMMUNITY_ENABLED=false
# 请求未显式指定 use_community 时的默认行为（保持"真 opt-in"请留 false）
COMMUNITY_DEFAULT_ENABLED=false
# 社区最小规模（节点数）；小于该值的社区并入跨边权重最大的相邻大社区
COMMUNITY_MIN_SIZE=20
# 目标社区数 = clamp(round(节点数 / COMMUNITY_TARGET_PER_NODES), MIN, MAX)
COMMUNITY_TARGET_PER_NODES=200
COMMUNITY_TARGET_MIN=6
COMMUNITY_TARGET_MAX=20
# 留空 = 按目标社区数自动二分搜索分辨率；填数值则固定分辨率（越大社区越碎）
# COMMUNITY_RESOLUTION=0.37
COMMUNITY_SEED=42
# 查询期注入的社区摘要条数与 token 上限
COMMUNITY_TOP_K=2
COMMUNITY_MAX_TOKENS=1500
COMMUNITY_SIM_THRESHOLD=0.35
# auto = 增量入库完成后自动刷新（未变化时 0 次 LLM 调用）；manual = 仅手动触发
COMMUNITY_REFRESH_MODE=auto
# 单个社区摘要输入 token 上限 / 并发 / 重试
COMMUNITY_SUMMARY_MAX_INPUT_TOKENS=3000
COMMUNITY_MAX_CONCURRENT_SUMMARIES=4
COMMUNITY_MAX_RETRIES=2
# 留空沿用主 LLM；也可指定更便宜的摘要模型
# COMMUNITY_SUMMARY_MODEL=
# 成员集合 Jaccard ≥ 该值时复用旧摘要（不调 LLM）
COMMUNITY_REUSE_JACCARD=0.9
COMMUNITY_PROMPT_VERSION=v1

# ==========================================
# 离线评测（RAGAS 判官）
# ==========================================
# RAGAS 裁判的最大输出 token（是上限不是目标，用不到不会多花钱）；
# 过小会因输出被截断导致指标缺失——不是报错，而是静默少算
EVAL_RAGAS_MAX_TOKENS=16384
